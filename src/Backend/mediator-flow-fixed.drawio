<mxfile host="app.diagrams.net">
  <diagram name="Mediator Flow (Commands, Queries, Notifications &amp; Pipeline)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Controller -->
        <mxCell id="controller" value="Controller" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Mediator -->
        <mxCell id="mediator" value="IMediator" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="220" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- COMMAND / QUERY lane -->
        <mxCell id="cqLabel" value="Command / Query Pipeline" style="text;html=1;align=left;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- Request (Command/Query) -->
        <mxCell id="request" value="Command / Query" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Pipeline Behaviors box -->
        <mxCell id="pipelineBox" value="Pipeline Behaviors" style="swimlane;childLayout=stackLayout;rounded=1;horizontal=0;startSize=28;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- Validation Behavior -->
        <mxCell id="validation" value="ValidationBehavior&lt;TReq,TRes&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=12" vertex="1" parent="pipelineBox">
          <mxGeometry x="20" y="40" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Logging Behavior -->
        <mxCell id="logging" value="LoggingBehavior&lt;TReq,TRes&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=12" vertex="1" parent="pipelineBox">
          <mxGeometry x="20" y="90" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Handler (for C/Q) -->
        <mxCell id="handler" value="Handler (CommandHandler / QueryHandler)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Repository / Service -->
        <mxCell id="repository" value="Repository / Service" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="220" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows for Command/Query lane -->
        <mxCell id="arrow1" edge="1" source="controller" target="mediator" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow2" edge="1" source="mediator" target="request" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow2b" edge="1" source="request" target="pipelineBox" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" edge="1" source="pipelineBox" target="handler" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow4" edge="1" source="handler" target="repository" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Labels -->
        <mxCell id="label1" value="Send(Command/Query)" style="text;html=1;align=center;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="90" y="200" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="Behaviors encadeados (validação, logs, transação, autorização...)" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="380" y="375" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- NOTIFICATION lane -->
        <mxCell id="notifLabel" value="Notifications (Publish)" style="text;html=1;align=left;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- Notification object -->
        <mxCell id="notification" value="UsuarioCriadoNotification" style="rounded=1;whiteSpace=wrap;fillColor=#fff4f4;strokeColor=#cc6666;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Notification handlers -->
        <mxCell id="notifH1" value="EnviarEmailBoasVindasHandler" style="rounded=1;whiteSpace=wrap;fillColor=#eaffea;strokeColor=#6abf69;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="680" y="440" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notifH2" value="RegistrarAuditoriaHandler" style="rounded=1;whiteSpace=wrap;fillColor=#eaffea;strokeColor=#6abf69;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="680" y="520" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Notification arrows (broadcast) -->
        <mxCell id="nArrow0" edge="1" source="controller" target="mediator" style="endArrow=classic;dashed=1;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nArrow1" edge="1" source="mediator" target="notification" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nArrow2" edge="1" source="notification" target="notifH1" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nArrow3" edge="1" source="notification" target="notifH2" style="endArrow=classic;strokeWidth=2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Explanations -->
        <mxCell id="labelPub" value="Publish(Notification) → vários handlers são executados (sem retorno)" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="540" width="330" height="30" as="geometry" />
        </mxCell>

        <!-- Extra Behaviors -->
        <mxCell id="auth" value="AuthorizationBehavior&lt;TReq,TRes&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=12" vertex="1" parent="pipelineBox">
          <mxGeometry x="20" y="140" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Transaction Behavior note (Commands only) -->
        <mxCell id="txnLabel" value="TransactionBehavior: aplica apenas a Commands (UoW/Commit/Rollback)" style="text;html=1;align=left;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="385" width="380" height="20" as="geometry" />
        </mxCell>
        
        <!-- Idempotency note for notifications -->
        <mxCell id="idempNote" value="Notifications: projetar handlers idempotentes e tolerantes a falhas (retry, dead-letter)" style="text;html=1;align=left;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="570" width="440" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
